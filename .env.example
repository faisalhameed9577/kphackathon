# Copy this file to ".env" (same folder) and fill in your values.
# NEVER commit your real .env file or share your keys.

# --- Required for AI features (summaries, cited answers, comparison, gap analysis) ---
# Free key: https://aistudio.google.com/apikey
# Without it the app still runs in limited mode (search, library, rule-based analysis, PDF).
GEMINI_API_KEY=

# Gemini model used for text generation. Leave empty to use the default (gemini-3.5-flash).
# If Google renames models and you see a "model not found" message, put a current model name here.
GEMINI_MODEL=

# --- Optional: PubMed (NCBI E-utilities) ---
# Public access works without these; a key raises the rate limit from 3 to 10 requests/second.
# Key: https://www.ncbi.nlm.nih.gov/account/settings/  ->  "API Key Management"
NCBI_API_KEY=
# NCBI asks API users to identify themselves with an email address.
NCBI_EMAIL=

# --- Optional extras ---
# Embedding model for semantic search (default: gemini-embedding-001)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Set to true to use offline keyword embeddings even when a Gemini key exists
# FORCE_LOCAL_EMBEDDINGS=false
# Store all data (SQLite, ChromaDB, papers, reports) somewhere else
# ZETESIS_DATA_DIR=D:\zetesis_data
